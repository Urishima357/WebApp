      <mxCell id="shw-chen-100" parent="1" value="Entitas = persegi panjang   |   Atribut = oval   |   Relasi = belah ketupat   |   PK = atribut bergaris bawah" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#000000;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=none;" vertex="1">
        <mxGeometry as="geometry" x="250" y="2230" width="2630" height="28" />
      </mxCell>
      <mxCell id="shw-chen-101" parent="1" value="1 / N = kardinalitas maksimum   |   Garis tunggal = partisipasi opsional   |   Garis ganda = partisipasi wajib" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#000000;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=none;" vertex="1">
        <mxGeometry as="geometry" x="90" y="2270" width="2790" height="28" />
      </mxCell>
      <mxCell id="shw-chen-102" parent="1" value="UK mengikuti LRS: MOTOR.kode_inventaris, no_polisi, no_rangka, no_mesin. FK diwakili relasi. Pembayaran 1:1 dan motor 0..1 penjualan mengikuti LRS." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#000000;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=none;" vertex="1">
