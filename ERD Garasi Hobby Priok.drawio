      </mxCell>
      <mxCell id="srv-chen-115" parent="1" value="Notasi Chen — diturunkan dari LRS Servis; nama, atribut, dan aturan hubungan mengikuti sumber." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#000000;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=none;" vertex="1">
        <mxGeometry as="geometry" x="70" y="112" width="2860" height="32" />
      </mxCell>
      <mxCell id="srv-chen-116" parent="1" value="LEGENDA" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#000000;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1">
        <mxGeometry as="geometry" x="90" y="2230" width="150" height="28" />
      </mxCell>
      <mxCell id="srv-chen-117" parent="1" value="Entitas = persegi panjang   |   Atribut = oval   |   Relasi = belah ketupat   |   PK = atribut bergaris bawah" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#000000;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=none;" vertex="1">
        <mxGeometry as="geometry" x="250" y="2230" width="2630" height="28" />
      </mxCell>
      <mxCell id="srv-chen-118" parent="1" value="1 / N = kardinalitas maksimum   |   Garis tunggal = partisipasi opsional   |   Garis ganda = partisipasi wajib" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#000000;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=none;" vertex="1">
        <mxGeometry as="geometry" x="90" y="2270" width="2790" height="28" />
      </mxCell>
      <mxCell id="srv-chen-119" parent="1" value="UK mengikuti LRS: KENDARAAN.no_polisi. FK ditunjukkan melalui relasi, bukan oval tambahan. Model ini mempertahankan LRS, termasuk pembayaran 1:1." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#000000;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=none;" vertex="1">
        <mxGeometry as="geometry" x="90" y="2310" width="2790" height="55" />
      </mxCell>
    </root>
  </mxGraphModel>
