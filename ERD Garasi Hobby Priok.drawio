      <mxCell id="srv-chen-114" parent="1" value="GARASI HOBBY  /  ERD SERVIS" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=30;fontColor=#000000;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1">
