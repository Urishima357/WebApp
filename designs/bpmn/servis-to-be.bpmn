<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Servis" targetNamespace="urn:garasi-hobby:servis:to-be">
  <bpmn:process id="Process_Servis" name="Servis motor Garasi Hobby Priok" isExecutable="false">
    <bpmn:documentation>Usulan penyelarasan dengan PRD v1.2, 19 November 2026. Proses deskriptif. Komunikasi eksternal dengan pelanggan digambarkan melalui tindakan staf yang mencatat hasilnya.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Servis">
      <bpmn:lane id="LaneStaf" name="Staf bengkel / kasir">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Estimasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>KeputusanPelanggan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Persetujuan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Foto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pantau</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TindakStok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pemakaian</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Aktual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Progres</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rekonsiliasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pembayaran</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SerahTerima</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LaneMekanik" name="Mekanik">
        <bpmn:flowNodeRef>Inspeksi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Servis</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LaneSistem" name="Sistem pencatatan">
        <bpmn:flowNodeRef>HitungEstimasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PeriksaStok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Stok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MenungguBarang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatatPemakaian</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HasilPemakaian</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Batalkan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HasilBatal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndBatal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tagihan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VerifikasiLunas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Lunas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Finalisasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Nota</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tutup</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Motor diterima">
      <bpmn:outgoing>Flow_Start_WO</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="WO" name="Buat WO dan catat kondisi motor">
      <bpmn:documentation>Catat pelanggan, motor, tanggal masuk, keluhan, kondisi dan staf penerima. Draft dapat disimpan sebelum data dan foto lengkap.</bpmn:documentation>
      <bpmn:incoming>Flow_Start_WO</bpmn:incoming>
      <bpmn:outgoing>Flow_WO_Inspeksi</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Inspeksi" name="Periksa motor dan laporkan kebutuhan">
      <bpmn:incoming>Flow_WO_Inspeksi</bpmn:incoming>
      <bpmn:outgoing>Flow_Inspeksi_Estimasi</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Estimasi" name="Catat inspeksi dan susun estimasi">
      <bpmn:documentation>Susun baris jasa dan barang. Simpan histori versi estimasi dan gunakan ambang persetujuan yang dikonfigurasi untuk revisi.</bpmn:documentation>
      <bpmn:incoming>Flow_Inspeksi_Estimasi</bpmn:incoming>
      <bpmn:incoming>Flow_Persetujuan_Estimasi</bpmn:incoming>
      <bpmn:incoming>Flow_Progres_Estimasi</bpmn:incoming>
      <bpmn:outgoing>Flow_Estimasi_HitungEstimasi</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="HitungEstimasi" name="Hitung estimasi dan validasi diskon">
      <bpmn:documentation>Diskon di atas batas menunggu persetujuan owner.</bpmn:documentation>
      <bpmn:incoming>Flow_Estimasi_HitungEstimasi</bpmn:incoming>
      <bpmn:outgoing>Flow_HitungEstimasi_KeputusanPelanggan</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="KeputusanPelanggan" name="Minta dan catat keputusan estimasi">
      <bpmn:documentation>WO menunggu persetujuan. Catat nama, metode, waktu, nilai atau versi estimasi dan staf pencatat. Owner dapat memberi override awal dengan izin dan alasan sesuai WKS-06.</bpmn:documentation>
      <bpmn:incoming>Flow_HitungEstimasi_KeputusanPelanggan</bpmn:incoming>
      <bpmn:outgoing>Flow_KeputusanPelanggan_Persetujuan</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Persetujuan" name="Hasil keputusan?" gatewayDirection="Diverging">
      <bpmn:documentation>Lanjut setelah persetujuan tercatat atau override awal yang sah. Perubahan aktual di atas ambang meminta persetujuan pelanggan ulang.</bpmn:documentation>
      <bpmn:incoming>Flow_KeputusanPelanggan_Persetujuan</bpmn:incoming>
      <bpmn:outgoing>Flow_Persetujuan_Foto</bpmn:outgoing>
      <bpmn:outgoing>Flow_Persetujuan_Estimasi</bpmn:outgoing>
      <bpmn:outgoing>Flow_Persetujuan_Rekonsiliasi</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Foto" name="Lengkapi foto kondisi awal">
      <bpmn:documentation>Minimal satu foto umum dan satu foto area masalah serta tambahan jika ada kerusakan lain. Akses foto privat. Pengerjaan menunggu foto lengkap.</bpmn:documentation>
      <bpmn:incoming>Flow_Persetujuan_Foto</bpmn:incoming>
      <bpmn:outgoing>Flow_Foto_PeriksaStok</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PeriksaStok" name="Periksa stok untuk langkah pekerjaan">
      <bpmn:documentation>Cek saldo dan tandai barang kurang berdasarkan kebutuhan yang belum dipenuhi.</bpmn:documentation>
      <bpmn:incoming>Flow_Foto_PeriksaStok</bpmn:incoming>
      <bpmn:incoming>Flow_TindakStok_PeriksaStok</bpmn:incoming>
      <bpmn:incoming>Flow_Progres_PeriksaStok</bpmn:incoming>
      <bpmn:outgoing>Flow_PeriksaStok_Stok</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Stok" name="Stok cukup?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_PeriksaStok_Stok</bpmn:incoming>
      <bpmn:outgoing>Flow_Stok_Pemakaian</bpmn:outgoing>
      <bpmn:outgoing>Flow_Stok_MenungguBarang</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="MenungguBarang" name="Ubah WO ke Menunggu Barang">
      <bpmn:incoming>Flow_Stok_MenungguBarang</bpmn:incoming>
      <bpmn:incoming>Flow_HasilPemakaian_MenungguBarang</bpmn:incoming>
      <bpmn:outgoing>Flow_MenungguBarang_Pantau</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Pantau" name="Pantau stok masuk atau tindak lanjuti pengadaan">
      <bpmn:documentation>Jika barang diterima dari pemasok, staf berizin memfinalisasi penerimaan pada proses barang masuk. Draft penerimaan tidak mengubah stok.</bpmn:documentation>
      <bpmn:incoming>Flow_MenungguBarang_Pantau</bpmn:incoming>
      <bpmn:outgoing>Flow_Pantau_TindakStok</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="TindakStok" name="Keputusan saat menunggu?" gatewayDirection="Diverging">
      <bpmn:documentation>Jika stok tersedia, periksa ulang. Jika pekerjaan dihentikan, ikuti pembatalan. PRD Bagian 13.1 mengizinkan WO Menunggu Barang beralih ke Dikerjakan atau Dibatalkan.</bpmn:documentation>
      <bpmn:incoming>Flow_Pantau_TindakStok</bpmn:incoming>
      <bpmn:outgoing>Flow_TindakStok_PeriksaStok</bpmn:outgoing>
      <bpmn:outgoing>Flow_TindakStok_Rekonsiliasi</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Pemakaian" name="Mulai atau lanjutkan WO dan konfirmasi barang diambil">
      <bpmn:documentation>Ubah WO ke Dikerjakan setelah syarat foto dan persetujuan terpenuhi. Konfirmasi barang aktual yang diambil atau dipakai. Langkah jasa tanpa barang tidak membuat movement.</bpmn:documentation>
      <bpmn:incoming>Flow_Stok_Pemakaian</bpmn:incoming>
      <bpmn:outgoing>Flow_Pemakaian_CatatPemakaian</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CatatPemakaian" name="Validasi dan catat barang keluar satu kali">
      <bpmn:documentation>Validasi jumlah aktual, kunci saldo dan catat movement keluaran dengan referensi WO secara atomik. Tolak stok kurang tanpa mutasi. Ulangan konfirmasi tidak mendebit ulang.</bpmn:documentation>
      <bpmn:incoming>Flow_Pemakaian_CatatPemakaian</bpmn:incoming>
      <bpmn:outgoing>Flow_CatatPemakaian_HasilPemakaian</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="HasilPemakaian" name="Boleh lanjut?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_CatatPemakaian_HasilPemakaian</bpmn:incoming>
      <bpmn:outgoing>Flow_HasilPemakaian_Servis</bpmn:outgoing>
      <bpmn:outgoing>Flow_HasilPemakaian_MenungguBarang</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Servis" name="Kerjakan servis sesuai lingkup yang disetujui">
      <bpmn:incoming>Flow_HasilPemakaian_Servis</bpmn:incoming>
      <bpmn:outgoing>Flow_Servis_Aktual</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Aktual" name="Catat jasa aktual dan periksa progres WO">
      <bpmn:documentation>Jika perubahan aktual melewati ambang, tahan pekerjaan dan finalisasi sampai persetujuan ulang. Catat barang tambahan sebelum diambil atau dipakai.</bpmn:documentation>
      <bpmn:incoming>Flow_Servis_Aktual</bpmn:incoming>
      <bpmn:outgoing>Flow_Aktual_Progres</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Progres" name="Tindak lanjut WO?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Aktual_Progres</bpmn:incoming>
      <bpmn:outgoing>Flow_Progres_Tagihan</bpmn:outgoing>
      <bpmn:outgoing>Flow_Progres_Estimasi</bpmn:outgoing>
      <bpmn:outgoing>Flow_Progres_PeriksaStok</bpmn:outgoing>
      <bpmn:outgoing>Flow_Progres_Rekonsiliasi</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Rekonsiliasi" name="Catat alasan batal dan rekonsiliasi barang">
      <bpmn:documentation>Sebelum transaksi final, pengembalian atau reversal harus sah, atau catat penjelasan movement yang sah. Jika estimasi ditolak sebelum pemakaian, stok tidak berubah.</bpmn:documentation>
      <bpmn:incoming>Flow_Persetujuan_Rekonsiliasi</bpmn:incoming>
      <bpmn:incoming>Flow_TindakStok_Rekonsiliasi</bpmn:incoming>
      <bpmn:incoming>Flow_Progres_Rekonsiliasi</bpmn:incoming>
      <bpmn:incoming>Flow_HasilBatal_Rekonsiliasi</bpmn:incoming>
      <bpmn:outgoing>Flow_Rekonsiliasi_Batalkan</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Batalkan" name="Validasi rekonsiliasi dan batalkan WO">
      <bpmn:documentation>Simpan histori. Tahan pembatalan jika barang yang sudah dikeluarkan belum direkonsiliasi.</bpmn:documentation>
      <bpmn:incoming>Flow_Rekonsiliasi_Batalkan</bpmn:incoming>
      <bpmn:outgoing>Flow_Batalkan_HasilBatal</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="HasilBatal" name="Rekonsiliasi sah?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Batalkan_HasilBatal</bpmn:incoming>
      <bpmn:outgoing>Flow_HasilBatal_EndBatal</bpmn:outgoing>
      <bpmn:outgoing>Flow_HasilBatal_Rekonsiliasi</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndBatal" name="WO dibatalkan">
      <bpmn:incoming>Flow_HasilBatal_EndBatal</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Tagihan" name="Tandai Siap Diambil dan hitung total aktual">
      <bpmn:documentation>Hitung total dari jasa dan barang aktual serta diskon sah. Verifikasi movement yang tercatat tanpa mendebit stok lagi.</bpmn:documentation>
      <bpmn:incoming>Flow_Progres_Tagihan</bpmn:incoming>
      <bpmn:outgoing>Flow_Tagihan_Pembayaran</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Pembayaran" name="Proses pembayaran dan pantau status">
      <bpmn:documentation>Staf berizin mengonfirmasi tunai atau transfer manual. Untuk QRIS atau e-wallet, sistem membuat permintaan gateway dan menunggu konfirmasi otomatis. Pembayaran lunas memakai satu metode.</bpmn:documentation>
      <bpmn:incoming>Flow_Tagihan_Pembayaran</bpmn:incoming>
      <bpmn:incoming>Flow_Lunas_Pembayaran</bpmn:incoming>
      <bpmn:outgoing>Flow_Pembayaran_VerifikasiLunas</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="VerifikasiLunas" name="Validasi nominal dan status pembayaran">
      <bpmn:documentation>Tunai boleh lebih dengan kembalian. Transfer dan gateway harus tepat nominal. Status gateway Paid berasal dari callback terverifikasi. Pending, Failed dan Expired tidak menutup transaksi.</bpmn:documentation>
      <bpmn:incoming>Flow_Pembayaran_VerifikasiLunas</bpmn:incoming>
      <bpmn:outgoing>Flow_VerifikasiLunas_Lunas</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Lunas" name="Lunas terverifikasi?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_VerifikasiLunas_Lunas</bpmn:incoming>
      <bpmn:outgoing>Flow_Lunas_Finalisasi</bpmn:outgoing>
      <bpmn:outgoing>Flow_Lunas_Pembayaran</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Finalisasi" name="Simpan transaksi dan pembayaran satu kali">
      <bpmn:documentation>Finalisasi atomik dan idempoten, satu transaksi final aktif per WO. Jika penyimpanan gagal, ulangi dengan referensi yang sama tanpa menagih atau mengurangi stok lagi.</bpmn:documentation>
      <bpmn:incoming>Flow_Lunas_Finalisasi</bpmn:incoming>
      <bpmn:outgoing>Flow_Finalisasi_Nota</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Nota" name="Terbitkan nota A4 dari transaksi final">
      <bpmn:documentation>Terbitkan setelah transaksi lunas tersimpan. Jika cetak gagal, ulangi cetak dari nota yang sama.</bpmn:documentation>
      <bpmn:incoming>Flow_Finalisasi_Nota</bpmn:incoming>
      <bpmn:outgoing>Flow_Nota_SerahTerima</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="SerahTerima" name="Serahkan nota dan catat penyerahan motor">
      <bpmn:incoming>Flow_Nota_SerahTerima</bpmn:incoming>
      <bpmn:outgoing>Flow_SerahTerima_Tutup</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Tutup" name="Ubah WO ke Selesai">
      <bpmn:documentation>Hanya setelah transaksi final dan penyerahan motor tercatat.</bpmn:documentation>
      <bpmn:incoming>Flow_SerahTerima_Tutup</bpmn:incoming>
      <bpmn:outgoing>Flow_Tutup_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End" name="Servis selesai">
      <bpmn:incoming>Flow_Tutup_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_WO" sourceRef="Start" targetRef="WO" />
    <bpmn:sequenceFlow id="Flow_WO_Inspeksi" sourceRef="WO" targetRef="Inspeksi" />
    <bpmn:sequenceFlow id="Flow_Inspeksi_Estimasi" sourceRef="Inspeksi" targetRef="Estimasi" />
    <bpmn:sequenceFlow id="Flow_Estimasi_HitungEstimasi" sourceRef="Estimasi" targetRef="HitungEstimasi" />
    <bpmn:sequenceFlow id="Flow_HitungEstimasi_KeputusanPelanggan" sourceRef="HitungEstimasi" targetRef="KeputusanPelanggan" />
    <bpmn:sequenceFlow id="Flow_KeputusanPelanggan_Persetujuan" sourceRef="KeputusanPelanggan" targetRef="Persetujuan" />
    <bpmn:sequenceFlow id="Flow_Persetujuan_Foto" sourceRef="Persetujuan" targetRef="Foto" name="Boleh lanjut" />
    <bpmn:sequenceFlow id="Flow_Foto_PeriksaStok" sourceRef="Foto" targetRef="PeriksaStok" />
    <bpmn:sequenceFlow id="Flow_PeriksaStok_Stok" sourceRef="PeriksaStok" targetRef="Stok" />
    <bpmn:sequenceFlow id="Flow_Stok_Pemakaian" sourceRef="Stok" targetRef="Pemakaian" name="Cukup" />
    <bpmn:sequenceFlow id="Flow_Stok_MenungguBarang" sourceRef="Stok" targetRef="MenungguBarang" name="Kurang" />
    <bpmn:sequenceFlow id="Flow_MenungguBarang_Pantau" sourceRef="MenungguBarang" targetRef="Pantau" />
    <bpmn:sequenceFlow id="Flow_Pantau_TindakStok" sourceRef="Pantau" targetRef="TindakStok" />
    <bpmn:sequenceFlow id="Flow_TindakStok_PeriksaStok" sourceRef="TindakStok" targetRef="PeriksaStok" name="Cek ulang" />
    <bpmn:sequenceFlow id="Flow_Pemakaian_CatatPemakaian" sourceRef="Pemakaian" targetRef="CatatPemakaian" />
    <bpmn:sequenceFlow id="Flow_CatatPemakaian_HasilPemakaian" sourceRef="CatatPemakaian" targetRef="HasilPemakaian" />
    <bpmn:sequenceFlow id="Flow_HasilPemakaian_Servis" sourceRef="HasilPemakaian" targetRef="Servis" name="Valid" />
    <bpmn:sequenceFlow id="Flow_HasilPemakaian_MenungguBarang" sourceRef="HasilPemakaian" targetRef="MenungguBarang" name="Stok kurang" />
    <bpmn:sequenceFlow id="Flow_Servis_Aktual" sourceRef="Servis" targetRef="Aktual" />
    <bpmn:sequenceFlow id="Flow_Aktual_Progres" sourceRef="Aktual" targetRef="Progres" />
    <bpmn:sequenceFlow id="Flow_Progres_Tagihan" sourceRef="Progres" targetRef="Tagihan" name="Siap Diambil" />
    <bpmn:sequenceFlow id="Flow_Tagihan_Pembayaran" sourceRef="Tagihan" targetRef="Pembayaran" />
    <bpmn:sequenceFlow id="Flow_Pembayaran_VerifikasiLunas" sourceRef="Pembayaran" targetRef="VerifikasiLunas" />
    <bpmn:sequenceFlow id="Flow_VerifikasiLunas_Lunas" sourceRef="VerifikasiLunas" targetRef="Lunas" />
    <bpmn:sequenceFlow id="Flow_Lunas_Finalisasi" sourceRef="Lunas" targetRef="Finalisasi" name="Ya" />
    <bpmn:sequenceFlow id="Flow_Lunas_Pembayaran" sourceRef="Lunas" targetRef="Pembayaran" name="Belum lunas" />
    <bpmn:sequenceFlow id="Flow_Finalisasi_Nota" sourceRef="Finalisasi" targetRef="Nota" />
    <bpmn:sequenceFlow id="Flow_Nota_SerahTerima" sourceRef="Nota" targetRef="SerahTerima" />
    <bpmn:sequenceFlow id="Flow_SerahTerima_Tutup" sourceRef="SerahTerima" targetRef="Tutup" />
    <bpmn:sequenceFlow id="Flow_Tutup_End" sourceRef="Tutup" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_Persetujuan_Estimasi" sourceRef="Persetujuan" targetRef="Estimasi" name="Revisi" />
    <bpmn:sequenceFlow id="Flow_Progres_Estimasi" sourceRef="Progres" targetRef="Estimasi" name="Di atas ambang" />
    <bpmn:sequenceFlow id="Flow_Progres_PeriksaStok" sourceRef="Progres" targetRef="PeriksaStok" name="Lanjut kerja" />
    <bpmn:sequenceFlow id="Flow_Persetujuan_Rekonsiliasi" sourceRef="Persetujuan" targetRef="Rekonsiliasi" name="Ditolak dan batal" />
    <bpmn:sequenceFlow id="Flow_TindakStok_Rekonsiliasi" sourceRef="TindakStok" targetRef="Rekonsiliasi" name="Batalkan WO" />
    <bpmn:sequenceFlow id="Flow_Progres_Rekonsiliasi" sourceRef="Progres" targetRef="Rekonsiliasi" name="Hentikan servis" />
    <bpmn:sequenceFlow id="Flow_Rekonsiliasi_Batalkan" sourceRef="Rekonsiliasi" targetRef="Batalkan" />
    <bpmn:sequenceFlow id="Flow_Batalkan_HasilBatal" sourceRef="Batalkan" targetRef="HasilBatal" />
    <bpmn:sequenceFlow id="Flow_HasilBatal_EndBatal" sourceRef="HasilBatal" targetRef="EndBatal" name="Ya" />
    <bpmn:sequenceFlow id="Flow_HasilBatal_Rekonsiliasi" sourceRef="HasilBatal" targetRef="Rekonsiliasi" name="Belum lengkap" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Servis">
    <bpmn:participant id="Bengkel" name="Bengkel Garasi Hobby Priok" processRef="Process_Servis" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_Servis" name="Servis motor TO-BE">
    <bpmndi:BPMNPlane id="Plane_Servis" bpmnElement="Collaboration_Servis">
      <bpmndi:BPMNShape id="Shape_Bengkel" bpmnElement="Bengkel" isHorizontal="true">
        <dc:Bounds x="70" y="40" width="4970" height="860" />
