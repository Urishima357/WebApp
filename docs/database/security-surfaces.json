  "findings": [
    {
      "id": "DBSEC-05",
      "severity": "MEDIUM",
      "summary": "Backup recovery works, but backups share the local disk and are not encrypted.",
      "evidence": "SQL backups restored and compared successfully; ACL protection does not protect against disk theft or disk failure.",
      "remediation": "Before real customer data: encrypt backups, keep a separate off-device copy, define retention/scheduling and repeat restore drills. Store encryption keys separately.",
      "status": "OPEN"
    },
    {
      "id": "DBSEC-08",
      "severity": "MEDIUM",
      "summary": "Foreign keys do not enforce mandatory child/payment presence.",
      "evidence": "A service note with no details or payment and a sale with its payment deleted were accepted on test clones.",
      "remediation": "Enforce creation/deletion through backend transactions and authorization; approve any further SQL enforcement before modifying the ERD implementation.",
      "status": "OPEN"
    }
  ],
